# Sistema Centinela (SICEN) — Variables de entorno Docker Compose
#
# Copiá este archivo a `.env` en la raíz del repo (gitignored) y reemplazá los `changeme`.
# El archivo .env es leído por docker-compose.yml para inyectar variables en los contenedores.
# Los secretos no tienen default en el YAML: si faltan, Compose aborta con el mensaje de ${VAR:?…}.
#
# NUNCA commitear .env con secretos reales. Este .env.example solo documenta la estructura.

# ────────────────────────────────────────────────────────────────────────────
# SICEN-back (Express API + frontend React)
# ────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
LOGGER_ENV=production
# Consola (stdout/stderr) en el contenedor: el rootfs es read-only.
# En local, LOG_TO_FILE=true escribe errors.log junto al proceso.
LOG_TO_FILE=false

# Autenticación JWT (OBLIGATORIO en producción)
# Reemplazá changeme por un secreto propio (p. ej. openssl rand -hex 32)
JWT_SECRET=changeme
JWT_EXPIRES_IN=8h

# MFA TOTP (obligatorio para admin / superAdmin). Distinta de JWT_SECRET.
# Generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=changeme
MFA_CHALLENGE_EXPIRES_IN=5m

# Base de datos MongoDB
# MONGO_URI es el host/esquema SIN usuario ni contraseña en la URI
# (GitGuardian marca el patrón credencial-en-URI). Las credenciales van
# aparte y el backend las inserta al conectar.
#
# Demo local (perfil demo): host mongo, puerto 27017, base SIGMU_DB, authSource=admin.
# Atlas: esquema mongodb+srv y el host del cluster; misma base SIGMU_DB.
MONGO_URI=mongodb://mongo:27017/SIGMU_DB?authSource=admin
MONGO_USER=sicen
# Misma contraseña que MONGO_INITDB_ROOT_PASSWORD en el perfil demo.
MONGO_PASSWORD=changeme

# CORS (obligatorio en producción; orígenes separados por coma)
CORS_ORIGIN=http://localhost:3000

# MongoDB local (perfil demo: docker compose --profile demo up)
# docker-compose.yml exige esta variable (sin default). Reemplazá changeme.
MONGO_INITDB_ROOT_PASSWORD=changeme

# URL pública base (links en emails)
API_URL=http://localhost:3000
PUBLIC_APP_URL=

# Nodemailer (ejemplo: Gmail con App Password)
GOOGLE_EMAIL=tu_email@gmail.com
GOOGLE_PASS=changeme

# ────────────────────────────────────────────────────────────────────────────
# El Centinela — Fuentes de datos AIS y satelitales
# ────────────────────────────────────────────────────────────────────────────

# AISStream: streaming AIS en vivo (https://aisstream.io)
AIS_STREAM_API_KEY=
AIS_BBOX=-36.0,-58.8,-33.8,-54.5

# Receptor AIS local (RTL-SDR + AIS-catcher) vía UDP NMEA
AIS_NMEA_UDP_ENABLED=false
AIS_NMEA_UDP_PORT=10110
AIS_NMEA_UDP_HOST=0.0.0.0

# Skylight: detecciones satelitales IUU (https://api.skylight.earth/docs/)
SKYLIGHT_API_KEY=
SKYLIGHT_BBOX=-38.5,-61.0,-30.5,-50.5
SKYLIGHT_CACHE_TTL_MS=300000

# Global Fishing Watch: identidad MMSI→OMI (https://globalfishingwatch.org/our-apis/)
GFW_API_TOKEN=
GFW_IDENTITY_CACHE_TTL_MS=604800000
GFW_EVENTS_CACHE_TTL_MS=300000

# FIU LAC IUU: FeatureServers públicos ArcGIS (sin API key)
FIU_IUU_BBOX=-48.5,-108.0,28.8,-17.5
FIU_IUU_CACHE_TTL_MS=300000

# Proxy meteo/oceanográfico: Open-Meteo (sin API key)
WIND_CACHE_TTL_MS=600000
CURRENTS_CACHE_TTL_MS=600000
WAVES_CACHE_TTL_MS=600000
BATHYMETRY_CACHE_TTL_MS=604800000
MARITIME_BOUNDARIES_CACHE_TTL_MS=604800000

# ────────────────────────────────────────────────────────────────────────────
# Simulador de derrames HC (SICEN-sim)
# ────────────────────────────────────────────────────────────────────────────
# URL interna del contenedor sim (desde back): http://sim:8091
HC_SIM_ENABLED=true
HC_SIM_URL=http://sim:8091
HC_SIM_TIMEOUT_MS=120000

# Simulador SAR (futuro)
SAR_SIM_ENABLED=false

# ────────────────────────────────────────────────────────────────────────────
# Opcional: Variables no usadas hoy pero declaradas en el backend
# ────────────────────────────────────────────────────────────────────────────
GITHUB_LOGIN_SECRET=
PERSISTENCE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ────────────────────────────────────────────────────────────────────────────
# Sentry (monitoreo de errores). Vacío = deshabilitado (sin init).
# Backend: runtime (env del contenedor). Frontend: build time (ARG en Dockerfile).
# No subir source maps ni auth tokens de Sentry.
# ────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=

# ────────────────────────────────────────────────────────────────────────────
# Frontend (Vite): solo variables con prefijo VITE_ son expuestas al cliente
# ────────────────────────────────────────────────────────────────────────────
# Key de basemaps CARTO (El Centinela). Dejar vacío = tiles con watermark.
VITE_CARTO_API_KEY=
