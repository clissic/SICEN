# Sistema Centinela (SICEN) — Variables de entorno (BACK)
#
# Copiá este archivo a:
#   - .env.development  (para `npm run dev` o `--mode DEVELOPMENT`)
#   - .env.production   (para `npm start` o `--mode PRODUCTION`)
#
# Nota JWT:
# - En PRODUCTION es obligatorio `JWT_SECRET` (si no existe el proceso termina).
# - En DEVELOPMENT, si `JWT_SECRET` falta, el código usa un secreto inseguro por defecto
#   (solo para local).

# Server
PORT=3000
LOGGER_ENV=development
# En Docker el default es consola (stdout). true = archivo (solo local).
# LOG_TO_FILE=false

# Autenticación JWT
JWT_SECRET=changeme
JWT_EXPIRES_IN=8h

# MFA TOTP (obligatorio para admin / superAdmin)
# En PRODUCTION es obligatorio (si falta, el proceso termina).
# Generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# No recicles JWT_SECRET: si rotás el JWT, los secretos TOTP dejarían de descifrarse.
MFA_ENCRYPTION_KEY=changeme
# Token de desafío entre login y TOTP (default 5m)
MFA_CHALLENGE_EXPIRES_IN=5m

# Base de datos (MongoDB) — host/esquema (obligatorio en producción)
# No pongas usuario ni contraseña en la URI: usá MONGO_USER y MONGO_PASSWORD.
# El backend las inserta al conectar (así no aparece el patrón credencial-en-URI).
#
# Local: host localhost, puerto 27017, base SIGMU_DB, authSource=admin.
# Atlas: mongodb+srv://<host-del-cluster>/SIGMU_DB?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/SIGMU_DB?authSource=admin
MONGO_USER=
MONGO_PASSWORD=

# URL pública base (links en emails y logo en correos)
# Si no querés mantener dos variables, podés setear solo una de estas:
# - API_URL (fallback)
# - PUBLIC_APP_URL (prioridad)
# El logo del email usa: {PUBLIC_APP_URL o API_URL}/img/Logo-PNN-Blanco.png (desde public/img/)
API_URL=http://localhost:3000
PUBLIC_APP_URL=

# Opcional: solo si el logo del mail debe cargarse desde otra URL base (CDN u otro dominio).
# Si está vacío, se usa la misma base que arriba (ideal: mismo host donde corre el backend con public/).
# EMAIL_LOGO_BASE_URL=https://tu-dominio.com

# Nodemailer (por ejemplo Gmail con App Password)
GOOGLE_EMAIL=
GOOGLE_PASS=

# Variables declaradas en src/config/env.config.js (algunas pueden no usarse hoy)
GITHUB_LOGIN_SECRET=
PERSISTENCE=

# CORS (Origins permitidos, separados por coma)
# En producción es OBLIGATORIO definir CORS_ORIGIN; el proceso falla si no está.
# En desarrollo, si falta, usa localhost por defecto.
CORS_ORIGIN=https://sicen.ejemplo.com,https://www.sicen.ejemplo.com

# Twilio (si se usa en el flujo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ────────────────────────────────────────────────────────────────────────────
# El Centinela — AIS
# ────────────────────────────────────────────────────────────────────────────
# AISStream: streaming AIS en vivo (https://aisstream.io)
AIS_STREAM_API_KEY=
# latMin,lonMin,latMax,lonMax (default en código: Montevideo/PREMO)
AIS_BBOX=-36.0,-58.8,-33.8,-54.5

# Receptor AIS local (RTL-SDR + AIS-catcher) vía UDP NMEA
# Habilitar solo si se configuró el hardware (ver SICEN-ais-receiver/README.md)
AIS_NMEA_UDP_ENABLED=false
# Puerto UDP donde escuchar mensajes NMEA (!AIVDM / !AIVDO)
AIS_NMEA_UDP_PORT=10110
# IP de la interfaz donde escuchar (0.0.0.0 = todas las interfaces)
AIS_NMEA_UDP_HOST=0.0.0.0

# El Centinela — Skylight (detecciones satelitales / IUU). https://api.skylight.earth/docs/
SKYLIGHT_API_KEY=
# Bbox Skylight: Uruguay + Río de la Plata / Atlántico (si vacío → AIS_BBOX → default código)
SKYLIGHT_BBOX=-38.5,-61.0,-30.5,-50.5
# TTL cache proxy Skylight en ms (default 300000 = 5 min)
SKYLIGHT_CACHE_TTL_MS=300000

# El Centinela — Global Fishing Watch (identidad MMSI→OMI en capa AIS)
# Token Bearer gratis (uso no comercial): https://globalfishingwatch.org/our-apis/
GFW_API_TOKEN=
# TTL cache identidad GFW en ms (default 604800000 = 7 días)
GFW_IDENTITY_CACHE_TTL_MS=604800000
# TTL cache eventos GFW en ms (default 300000 = 5 min)
GFW_EVENTS_CACHE_TTL_MS=300000

# El Centinela — FIU LAC IUU (FeatureServers públicos ArcGIS; sin API key)
# Bbox: latMin,lonMin,latMax,lonMax (si vacío → AIS_BBOX → default LAC)
FIU_IUU_BBOX=-48.5,-108.0,28.8,-17.5
# TTL cache proxy FIU IUU en ms (default 300000 = 5 min)
FIU_IUU_CACHE_TTL_MS=300000

# El Centinela — proxy viento (Open-Meteo). TTL de cache en ms (default 600000 = 10 min)
WIND_CACHE_TTL_MS=600000

# El Centinela — proxy corrientes (Open-Meteo Marine / SMOC). TTL de cache en ms
CURRENTS_CACHE_TTL_MS=600000

# El Centinela — proxy oleaje (altura + período). TTL de cache en ms
WAVES_CACHE_TTL_MS=600000

# El Centinela — proxy batimetría GEBCO (dato estático). TTL de cache en ms (default 7 días)
BATHYMETRY_CACHE_TTL_MS=604800000

# El Centinela — límites marítimos MarineRegions (12 MN / 24 MN / ZEE). TTL cache ms (default 7 días)
MARITIME_BOUNDARIES_CACHE_TTL_MS=604800000

# El Centinela — simulador de derrames HC (worker SICEN-sim)
# Arrancar: cd SICEN-sim && uvicorn app.main:app --port 8091
HC_SIM_ENABLED=false
HC_SIM_URL=http://127.0.0.1:8091
HC_SIM_TIMEOUT_MS=120000
SAR_SIM_ENABLED=false

