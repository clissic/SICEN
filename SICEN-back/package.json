{
  "type": "module",
  "name": "sicen-back",
  "version": "1.0.0",
  "description": "Sistema Centinela — aplicación web Prefectura Puerto Montevideo",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:client": "npm run build --prefix ../SICEN-front",
    "build": "npm run build:client",
    "dev:client": "npm run build:watch --prefix ../SICEN-front",
    "dev:server": "nodemon ./src/app.js --mode DEVELOPMENT",
    "dev": "concurrently -n front,api -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "start": "node ./src/app.js --mode PRODUCTION"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clissic/SIGMU.git"
  },
  "keywords": [
    "Armada",
    "PREMO",
    "Prefectura",
    "Montevideo",
    "Sistema Centinela"
  ],
  "author": "JPC",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/clissic/SIGMU/issues"
  },
  "homepage": "https://github.com/clissic/SIGMU#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "commander": "^15.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.12.0",
    "mongoose-paginate-v2": "^1.9.5",
    "multer": "^2.1.1",
    "nodemailer": "^10.3.1",
    "polygon-clipping": "^0.15.7",
    "sweetalert2": "^11.7.31",
    "winston": "^3.10.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "qs": "^6.17.1",
    "tar": "^7.5.22",
    "ip-address": "^10.7.6",
    "shell-quote": "^1.12.0",
    "minimatch": "^11.0.4"
  }
}
