# Host donde el backend SICEN escucha mensajes NMEA vía UDP.
# host.docker.internal funciona en Docker Desktop y, gracias a extra_hosts
# (host-gateway) del docker-compose.yml, también en Linux.
UDP_HOST=host.docker.internal

# Puerto UDP donde SICEN-back escucha (debe coincidir con AIS_NMEA_UDP_PORT del backend)
UDP_PORT=10110

# Opciones de AIS-catcher (se pasan tal cual como argumentos).
# Referencia: https://github.com/jvde-github/AIS-catcher  y  https://docs.aiscatcher.org
# Flags usados en esta guía:
#   -gr tuner auto   : ganancia del tuner RTL-SDR automática (o un valor, ej. -gr tuner 38.6)
#   -p <ppm>         : corrección de frecuencia en PPM del dongle (ej. -p -3)
#   -s <rate>        : sample rate (ej. -s 1536K)
#   -N 8100          : (opcional) visor web de AIS-catcher en el puerto 8100
# El docker-compose ya agrega "-u UDP_HOST UDP_PORT" (salida NMEA por UDP)
# y "-v 10" (verbose: estadísticas cada 10 segundos); no repetirlos acá.
AIS_CATCHER_OPTS=-gr tuner auto
