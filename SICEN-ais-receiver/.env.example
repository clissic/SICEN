# Host donde el backend SICEN escucha mensajes NMEA vía UDP
# En Docker Desktop (Windows/Mac): host.docker.internal
# En Linux con red bridge: dirección IP del host o 172.17.0.1
UDP_HOST=host.docker.internal

# Puerto UDP donde SICEN-back escucha (debe coincidir con AIS_NMEA_UDP_PORT en .env.development)
UDP_PORT=10110

# Opciones adicionales de AIS-catcher
# Ver documentación: https://github.com/jvde-github/AIS-catcher
# Ejemplos:
#   -gr tuner auto          : Ganancia automática
#   -F                      : Imprimir estadísticas cada 10 segundos
#   -M DCC                  : Usar filtro DC (recomendado para RTL-SDR)
#   -s 1536K                : Sample rate (por defecto 1536K)
#   -p -3                   : Corrección de frecuencia en PPM
AIS_CATCHER_OPTS=-gr tuner auto -F -M DCC
