# SICEN AIS Ingest — Variables de entorno
#
# Copiá este archivo a .env.ais para desarrollo local

# MongoDB (usar la misma base que SICEN-back)
AIS_MONGODB_URI=mongodb://localhost:27017/SICEN

# Protocolo de escucha (udp o tcp)
AIS_PROTOCOL=udp

# Host para escuchar (0.0.0.0 para todas las interfaces)
AIS_HOST=0.0.0.0

# Puerto para escuchar mensajes NMEA AIVDM
AIS_PORT=10110

# Colección MongoDB (opcional, default: aisPositions)
AIS_COLLECTION=aisPositions

# Nivel de logging
LOG_LEVEL=INFO
