# Sistema Centinela (SICEN) — Variables de entorno (FRONT)
#
# Copiá este archivo a `.env.development` y/o `.env.production` (gitignored).
# Vite solo expone al cliente las variables con prefijo `VITE_`.
#
# El proxy de /api está en `vite.config.js`. La auth JWT vive en localStorage.

# Key de basemaps CARTO (El Centinela). Se agrega como `?key=` a las URLs de tiles
# (voyager / dark_all) para quitar el watermark. Visible en el navegador (tiles
# se piden desde el cliente). Dejar vacío = tiles sin key (con watermark).
VITE_CARTO_API_KEY=

# ────────────────────────────────────────────────────────────────────────────
# Sentry (errores frontend). Vite embebe VITE_* en build time / `vite`.
# Vacío = no se inicializa. Nunca hardcodear el DSN. Sin Session Replay.
# En Docker: pasar como build args del Dockerfile (ver docker-compose.yml).
# ────────────────────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=
# Opcional; si falta usa import.meta.env.MODE
VITE_SENTRY_ENVIRONMENT=
# 0–1; default 0.1 si está vacío
VITE_SENTRY_TRACES_SAMPLE_RATE=
# 1 = log de debug si no hay DSN
# VITE_SENTRY_DEBUG=
