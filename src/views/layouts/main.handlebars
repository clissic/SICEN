<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="/assets/styles/styles.css" />
    <title>Sistema Centinela de la Prefectura del Puerto de Montevideo</title>
  </head>
  <body>
    {{{body}}}

    <button
      id="themeToggle"
      class="themeToggle"
      type="button"
      role="switch"
      aria-checked="false"
      aria-label="Cambiar modo claro/oscuro"
      title="Cambiar modo claro/oscuro"
    >
      <span class="themeToggle__track" aria-hidden="true">
        <span class="themeToggle__thumb" aria-hidden="true"></span>
      </span>
      <span class="themeToggle__icons" aria-hidden="true">
        <i class="bi bi-sun-fill themeToggle__icon themeToggle__icon--sun"></i>
        <i class="bi bi-moon-stars-fill themeToggle__icon themeToggle__icon--moon"></i>
      </span>
    </button>

    <div id="footer">
      <p id="marca">Desarrollado por <a href="https://jpc-dev.uy" target="_blank">JPC®</a> - Montevideo - 25/09/2023</p>
      <p id="marca">Versión de DESARROLLO</p>
      <img src="/img/LogoJPC.svg" alt="JPC logo" />
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="/assets/js/index.js"></script>
  </body>
</html>